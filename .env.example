# API host, including any trailing segment such as `/api/`.
VITE_API_BASE_URL=https://example.mwafq.com/api/
# Optional prefix for every endpoint path (e.g. `ServiceProvider`).
VITE_API_ROOT=
# Origin of static media (icons, logos, attachments). The API returns paths
# relative to it, e.g. `content/ServiceProviderAttachments/4/1/file.pdf`.
VITE_MEDIA_BASE_URL=https://example.mwafq.com/
# localStorage key for the signed-in session (optional, default `sp-auth`).
VITE_AUTH_LOCAL_STORAGE_KEY=
